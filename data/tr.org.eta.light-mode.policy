<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>ETA</vendor>

  <action id="tr.org.eta.light-mode.apply-all-users">
    <description>Apply ETA Light Mode settings to all users</description>
    <description xml:lang="tr">ETA Hafif Mod ayarlarını tüm kullanıcılara uygula</description>
    <message>Authentication is required to apply light mode settings system-wide</message>
    <message xml:lang="tr">Hafif mod ayarlarını tüm sisteme uygulamak için kimlik doğrulaması gerekir</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/eta/eta-light-mode/src/Action.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
